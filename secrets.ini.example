# Copy to secrets.ini and fill in:   cp secrets.ini.example secrets.ini && chmod 600 secrets.ini
# secrets.ini is gitignored and never shown in the web dashboard.

[mqtt]
# Home Assistant user created for the Mosquitto add-on
username = tft911
password =

[transcribe]
# Same value as TRANSCRIBE_TOKEN on the transcription server
token =

[stream]
# Icecast <source-password> from /etc/icecast2/icecast.xml
source_password =
