# /etc/tft911-transcriber.env — chmod 600, owned by root
# Generate a token:  python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Put the same value in the Pi's secrets.ini under [transcribe] token
TRANSCRIBE_TOKEN=

# tiny.en / base.en / small.en / medium.en — small.en is a good accuracy/speed balance on CPU
WHISPER_MODEL=small.en
# 0 = use every core the container has
WHISPER_THREADS=0

TRANSCRIBE_BIND=0.0.0.0
TRANSCRIBE_PORT=8765

# Where faster-whisper caches downloaded models
HF_HOME=/opt/tft911-transcriber/models

# Uncomment only if CTranslate2 crashes with "Illegal instruction" on the Xeon E5 v2
# CT2_FORCE_CPU_ISA=AVX
